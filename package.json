{
  "name": "mycron",
  "version": "0.0.0",
  "private": true,
  "description": "MyCron — Vercel-previewable Vite React demo app plus mock-free UI contract.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --config app/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p app/tsconfig.json --noEmit && tsc -p packages/schema/tsconfig.json && tsc -p apps/cli/tsconfig.json --noEmit",
    "build": "npm run build:cli && vite build --config app/vite.config.ts",
    "preview": "vite preview --config app/vite.config.ts --host 127.0.0.1",
    "test": "vitest run --config app/vitest.config.ts && vitest run --config apps/cli/vitest.config.ts",
    "test:cli": "vitest run --config apps/cli/vitest.config.ts",
    "build:cli": "esbuild apps/cli/src/main.ts --bundle --platform=node --format=esm --outfile=apps/cli/dist/main.js"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.19.20",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.27.7",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4",
    "zod": "^3.25.76"
  },
  "bin": {
    "mycron": "apps/cli/dist/main.js"
  }
}

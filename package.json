{
  "name": "mycron",
  "version": "0.0.0",
  "private": true,
  "description": "MyCron — Vercel-previewable Vite React demo app plus mock-free UI contract.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --config app/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p app/tsconfig.json --noEmit",
    "build": "vite build --config app/vite.config.ts",
    "preview": "vite preview --config app/vite.config.ts --host 127.0.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.6.3",
    "vite": "^6.4.3"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4"
  }
}
